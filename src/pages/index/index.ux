<template>
  <div class="page">
    <div class="status">
      <div class="dot dot-on" if="{{ connected }}"></div>
      <div class="dot dot-off" else></div>
      <text class="status-text" if="{{ connected }}">已连接手机</text>
      <text class="status-text" else>未连接手机</text>
    </div>

    <div class="card" if="{{ hasAlert }}" @click="openAlert">
      <text class="card-sat">{{ sat }}</text>
      <text class="card-time">{{ countdown }}</text>
      <text class="card-tip">点击查看</text>
    </div>

    <div class="card card-empty" else>
      <text class="card-tip">等待手机推送过境提醒</text>
    </div>

    <div class="btn" @click="testAlert">
      <text class="btn-text">测试提醒</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { formatCountdown, remainingMs, isExpired, makeTestAlert } from '../../common/utils/alert'

/**
 * 待命页。
 *
 * 手环端应用必须停在前台才能收到 interconnect 消息（后台白名单不含它），
 * 所以这个页面的职责就是"占住前台"：显示连接状态、最近一条提醒，
 * 并在收到推送时自动跳到提醒页。
 */
export default {
  private: {
    connected: false,
    hasAlert: false,
    sat: '',
    countdown: '--:--'
  },

  // 是否已经跳转到提醒页：避免同一时刻收到多条推送时叠加多个提醒页
  onAlertPage: false,
  timerId: null,
  unregister: null,

  onInit() {
    const app = this.$app.$def
    // 注册推送回调：收到新的提醒立即跳到全屏提醒页
    this.unregister = app.setAlertHandler(() => this.handleIncoming())
    this.refresh()
  },

  onShow() {
    this.onAlertPage = false
    this.refresh()
    this.startTimer()
  },

  onHide() {
    this.onAlertPage = true
    this.stopTimer()
  },

  onDestroy() {
    this.stopTimer()
    if (this.unregister) {
      this.unregister()
      this.unregister = null
    }
  },

  startTimer() {
    this.stopTimer()
    // 1 秒一跳即可：待命页只显示剩余时间，不需要平滑动画
    this.timerId = setInterval(() => this.refresh(), 1000)
  },

  stopTimer() {
    if (this.timerId !== null) {
      clearInterval(this.timerId)
      this.timerId = null
    }
  },

  refresh() {
    const app = this.$app.$def
    this.connected = app.isConnected()

    const alert = app.lastAlert
    if (alert && !isExpired(alert, Date.now(), app.offset)) {
      this.hasAlert = true
      this.sat = alert.sat
      this.countdown = this.formatRemaining(alert)
    } else {
      this.hasAlert = false
    }
  },

  formatRemaining(alert) {
    const app = this.$app.$def
    const ms = remainingMs(alert, Date.now(), app.offset)
    if (ms <= 0) return '过境中'
    return 'AOS ' + formatCountdown(ms / 1000)
  },

  handleIncoming() {
    this.refresh()
    if (this.onAlertPage) return
    this.openAlert()
  },

  openAlert() {
    const alert = this.$app.$def.lastAlert
    if (!alert) return
    this.onAlertPage = true
    router.push({ uri: '/pages/alert' })
  },

  /** 调试入口：不依赖手机，直接造一条 15 秒后 AOS 的提醒 */
  testAlert() {
    this.$app.$def.injectTestAlert(makeTestAlert(15, Date.now()))
    this.openAlert()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding-top: 30px;
  padding-bottom: 24px;
  background-color: #000000;
}

.status {
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
  margin-right: 6px;
}

.dot-on {
  background-color: #00e09e;
}

.dot-off {
  background-color: #6b7280;
}

.status-text {
  font-size: 13px;
  color: #9ca3af;
}

.card {
  width: 156px;
  padding-top: 14px;
  padding-bottom: 14px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border-radius: 18px;
  background-color: #111827;
}

.card-empty {
  background-color: #0b0f17;
}

.card-sat {
  font-size: 16px;
  color: #e5e7eb;
  text-align: center;
}

.card-time {
  margin-top: 6px;
  font-size: 26px;
  font-weight: 700;
  color: #00e09e;
  text-align: center;
}

.card-tip {
  margin-top: 6px;
  font-size: 11px;
  color: #6b7280;
  text-align: center;
}

.btn {
  width: 120px;
  height: 34px;
  justify-content: center;
  align-items: center;
  border-radius: 17px;
  background-color: #1f2937;
}

.btn-text {
  font-size: 14px;
  color: #d1d5db;
}
</style>
