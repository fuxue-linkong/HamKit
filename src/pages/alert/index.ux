<template>
  <div class="page" @swipe="handleSwipe">
    <!-- 环形倒计时：Vela 无 canvas/rotate（用了会导致手环重启），
         蓝环用原生 progress type=arc，横排数字用预生成旋转帧图（scripts/gen-ring-frames.py） -->
    <stack class="ring-box" style="width: {{ ringSize }}px; height: {{ ringSize }}px">
      <progress
        type="arc"
        percent="{{ pct }}"
        class="ring"
        style="width: {{ ringSize }}px; height: {{ ringSize }}px; start-angle: 0; total-angle: 360deg; stroke-width: 10px"
      ></progress>
      <image class="digits" src="{{ frameSrc }}" object-fit="contain"></image>
    </stack>

    <text class="sat">{{ sat }}</text>

    <image class="hint" src="/common/ring/hint.png" object-fit="contain"></image>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import device from '@system.device'
import { remainingMs } from '../../common/utils/alert'

/** 收到提醒时的倒计时窗口：用来算进度环比例 */
const LEAD_WINDOW_MS = 60 * 1000
/** AOS 之后再多显示 1 分钟，避免刚过境页面就消失造成误解 */
const AUTO_CLOSE_AFTER_MS = 60 * 1000

/**
 * 全屏提醒页（充电屏保式环形倒计时）。
 *
 * 数据源固定取 app 上的 lastAlert，而不是 router 参数：
 * 对象参数跨页面传递在部分平台上会被序列化成字符串，直接取引用更稳，
 * 也不会出现"页面拿到了但字段丢了"的情况。
 *
 * 注意：Vela 手环不支持 canvas 与 transform rotate（用了会整机重启），
 * 一切视觉都用原生 progress + image + text 实现。
 */
export default {
  private: {
    sat: '',
    // 进度环百分比（满环 60s 递减），绑定 progress percent
    pct: 100,
    // 当前数字帧文件名（00 = "00:00" 帧），src 在 tick 里按秒切换
    frameSrc: '/common/ring/frames/59.png',
    // 环形容器边长：默认按手环 9 的 192 宽屏取 176，onInit 按真机覆盖
    ringSize: 176
  },

  alert: null,
  offset: 0,
  timerId: null,
  vibratedAtAos: false,
  // 上一秒的倒计时值：跳秒时才切换帧图，避免每秒重复赋值触发图片重载
  lastSecond: -1,

  onInit() {
    const app = this.$app.$def
    this.alert = app.lastAlert
    this.offset = app.offset || 0

    // 没有提醒数据（例如用户直接从桌面进入）时立刻退回待命页
    if (!this.alert) {
      router.back()
      return
    }

    this.sat = this.alert.sat
    // 回执：让手机端知道提醒已经展示，可用于日志与去重
    app.sendAck(this.alert.id, 'shown')

    this.pickRingSize()
  },

  /**
   * 按真机屏幕宽度选环尺寸档位。
   *
   * device.getInfo 是异步回调 API（不能同步取返回值）。
   * designWidth=device-width，px 即物理像素：手环 9 屏宽 192，9 Pro 屏宽 336。
   */
  pickRingSize() {
    try {
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth
          if (w && w >= 300) {
            this.ringSize = 300
          }
        }
      })
    } catch (e) {
      // 拿不到屏幕信息就保持默认档（手环 9），不影响展示
      console.info('device.getInfo failed: ' + e)
    }
  },

  onShow() {
    // 进入即长振动：这是"到点了"的第一反馈，比屏幕亮起更直接
    this.vibrate()
    this.tick()
    this.timerId = setInterval(() => this.tick(), 1000)
  },

  onHide() {
    this.stopTimer()
  },

  onDestroy() {
    this.stopTimer()
  },

  tick() {
    if (!this.alert) return

    const ms = remainingMs(this.alert, Date.now(), this.offset)

    // 到点之后再震一次，提示"卫星已经升起来了"
    if (ms <= 0 && !this.vibratedAtAos) {
      this.vibratedAtAos = true
      this.vibrate()
    }

    // 过期太久自动关闭，避免用户走开后页面一直挂着
    if (ms < -AUTO_CLOSE_AFTER_MS) {
      this.close()
      return
    }

    // 剩余比例：满环 60s，随时间递减（同倒计时直觉）
    const ratio = Math.max(0, Math.min(1, ms / LEAD_WINDOW_MS))
    this.pct = Math.round(ratio * 100)

    // 帧图按秒切换；>59s（推送早于窗口）clamp 到 00:59 帧
    const sec = Math.min(59, Math.max(0, Math.floor(Math.max(0, ms) / 1000)))
    if (sec !== this.lastSecond) {
      this.lastSecond = sec
      this.frameSrc = '/common/ring/frames/' + String(sec).padStart(2, '0') + '.png'
    }
  },

  stopTimer() {
    if (this.timerId !== null) {
      clearInterval(this.timerId)
      this.timerId = null
    }
  },

  vibrate() {
    try {
      vibrator.vibrate({ mode: 'long' })
    } catch (e) {
      // 部分设备/省电模式下振动会被系统拒绝，不影响页面展示
      console.info('vibrate failed: ' + e)
    }
  },

  handleSwipe(e) {
    // 关闭手势：内容横置（数字帧旋转 90°）后，横持时"上滑"对应物理 left/right；
    // 保留 up 兼容竖持习惯，三个方向均可关闭避免关不掉
    if (e && (e.direction === 'up' || e.direction === 'left' || e.direction === 'right')) {
      this.close()
    }
  },

  close() {
    const app = this.$app.$def
    if (this.alert) app.sendAck(this.alert.id, 'dismiss')
    this.stopTimer()
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}

/* 层叠容器：progress 环打底，数字帧图叠在环心 */
.ring-box {
  position: relative;
}

.ring {
  position: absolute;
  left: 0;
  top: 0;
}

/* 数字帧：黑底白字与页面背景同色；contain 等比缩放适配不同环径 */
.digits {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.sat {
  margin-top: 6px;
  font-size: 16px;
  color: #0a84ff;
  text-align: center;
}

/* 提示小字帧图（预旋转），高度自适应 */
.hint {
  margin-top: 8px;
  height: 46px;
  object-fit: contain;
}
</style>
