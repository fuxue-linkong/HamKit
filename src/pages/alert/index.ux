<template>
  <div class="page" @swipe="handleSwipe">
    <text class="label">AOS 倒计时</text>

    <text class="time">{{ countdown }}</text>

    <text class="sat">{{ sat }}</text>

    <div class="bar">
      <div class="bar-inner" style="width: {{ barWidth }}"></div>
    </div>

    <text class="hint">上滑关闭</text>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { formatCountdown, remainingMs } from '../../common/utils/alert'

/** 进度条总宽（设备像素，designWidth=device-width） */
const BAR_TOTAL = 140
/** 收到提醒时的倒计时窗口：用来算进度条比例 */
const LEAD_WINDOW_MS = 60 * 1000
/** AOS 之后再多显示 1 分钟，避免刚过境页面就消失造成误解 */
const AUTO_CLOSE_AFTER_MS = 60 * 1000

/**
 * 全屏提醒页。
 *
 * 数据源固定取 app 上的 lastAlert，而不是 router 参数：
 * 对象参数跨页面传递在部分平台上会被序列化成字符串，直接取引用更稳，
 * 也不会出现"页面拿到了但字段丢了"的情况。
 */
export default {
  private: {
    sat: '',
    countdown: '--:--',
    // 用带单位的字符串，模板里直接 style="width: {{ barWidth }}"
    barWidth: BAR_TOTAL + 'px'
  },

  alert: null,
  offset: 0,
  timerId: null,
  vibratedAtAos: false,

  onInit() {
    const app = this.$app.$def
    this.alert = app.lastAlert
    this.offset = app.offset || 0

    // 没有提醒数据（例如用户直接从桌面进入）时立刻退回待命页
    if (!this.alert) {
      router.back()
      return
    }

    this.sat = this.alert.sat
    // 回执：让手机端知道提醒已经展示，可用于日志与去重
    app.sendAck(this.alert.id, 'shown')
  },

  onShow() {
    // 进入即长振动：这是"到点了"的第一反馈，比屏幕亮起更直接
    this.vibrate()
    this.tick()
    this.timerId = setInterval(() => this.tick(), 1000)
  },

  onHide() {
    this.stopTimer()
  },

  onDestroy() {
    this.stopTimer()
  },

  tick() {
    if (!this.alert) return

    const ms = remainingMs(this.alert, Date.now(), this.offset)

    // 到点之后再震一次，提示"卫星已经升起来了"
    if (ms <= 0 && !this.vibratedAtAos) {
      this.vibratedAtAos = true
      this.vibrate()
    }

    // 过期太久自动关闭，避免用户走开后页面一直挂着
    if (ms < -AUTO_CLOSE_AFTER_MS) {
      this.close()
      return
    }

    this.countdown = formatCountdown(Math.max(0, ms / 1000))

    const ratio = Math.max(0, Math.min(1, ms / LEAD_WINDOW_MS))
    this.barWidth = Math.round(BAR_TOTAL * ratio) + 'px'
  },

  stopTimer() {
    if (this.timerId !== null) {
      clearInterval(this.timerId)
      this.timerId = null
    }
  },

  vibrate() {
    try {
      vibrator.vibrate({ mode: 'long' })
    } catch (e) {
      // 部分设备/省电模式下振动会被系统拒绝，不影响页面展示
      console.info('vibrate failed: ' + e)
    }
  },

  handleSwipe(e) {
    // 上滑关闭；其它方向忽略（避免误触）
    if (e && e.direction === 'up') {
      this.close()
    }
  },

  close() {
    const app = this.$app.$def
    if (this.alert) app.sendAck(this.alert.id, 'dismiss')
    this.stopTimer()
    router.back()
  }
}
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
  padding-left: 12px;
  padding-right: 12px;
}

.label {
  font-size: 12px;
  color: #6b7280;
  letter-spacing: 2px;
}

.time {
  margin-top: 4px;
  font-size: 46px;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
}

.sat {
  margin-top: 2px;
  font-size: 18px;
  color: #00e09e;
  text-align: center;
}

.bar {
  width: 140px;
  height: 4px;
  margin-top: 14px;
  border-radius: 2px;
  background-color: #1f2937;
}

.bar-inner {
  height: 4px;
  border-radius: 2px;
  background-color: #00e09e;
}

.hint {
  margin-top: 12px;
  font-size: 11px;
  color: #4b5563;
}
</style>
