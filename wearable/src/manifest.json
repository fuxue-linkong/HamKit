{
  "package": "com.example.hamkit",
  "name": "卫星过境",
  "icon": "/common/icon.png",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.interconnect" },
    { "name": "system.vibrator" },
    { "name": "system.router" },
    { "name": "system.device" },
    { "name": "system.app" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": "device-width"
  },
  "display": {
    "backgroundColor": "#000000"
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/alert": {
        "component": "index"
      }
    }
  }
}
