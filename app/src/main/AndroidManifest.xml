<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 定位权限：核心业务依赖 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- FT8 解码：麦克风录音 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- APRS 前台 Service：连接期间保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
      SSTV 播放捕获（Android 10+）：解码其它应用正在播放的音频需要 MediaProjection，
      而 Android 14 起要求调用 getMediaProjection() 之前已有一个
      foregroundServiceType="mediaProjection" 的前台服务在运行。
      注意：服务必须在拿到授权之后才启动 —— 部分厂商 ROM 会额外校验投影 token
      （CAPTURE_VIDEO_OUTPUT / project_media），无授权启动该类型前台服务会崩溃。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 应用内更新：安装 APK（Android 8+ 需显式声明） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 日程提醒所需权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      SSTV 图库导出到系统相册：
      Android 10（API 29）起 MediaStore 分区存储不需要权限；仅 9 及以下需要，
      故用 maxSdkVersion 限死，避免在新系统上多要一个无用的敏感权限。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />


    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <application
        android:name=".HamKitApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HamKit"
        tools:targetApi="31">

        <!-- 高德地图 SDK Key：由 manifestPlaceholders 在构建时注入 -->
        <!-- Key 绑定 SHA1+包名，且 Release APK 启用 R8 混淆 -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_SDK_KEY}" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HamKit"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider：日志分享、文件下载等场景使用 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- APRS 前台 Service：连接期间保活 + 状态通知 -->
        <service
            android:name=".data.aprs.AprsService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          SSTV 播放捕获的前台服务：只为满足「先有 mediaProjection 前台服务、再取投影」
          的平台要求（Android 14+），本身不做采集。
        -->
        <service
            android:name=".data.sstv.SstvCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 接收 AlarmManager 触发的过境提醒广播 -->
        <receiver
            android:name=".data.reminder.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.hamkit.ACTION_TRIGGER_REMINDER" />
            </intent-filter>
        </receiver>

        <!-- 设备重启后恢复提醒闹钟（AlarmManager 重启后清空所有闹钟） -->
        <receiver
            android:name=".data.reminder.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 时间卡片背景裁剪 Activity，显式声明主题确保确认按钮可见 -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:theme="@style/Theme.AppCompat.Light"
            tools:replace="android:theme" />

        <!-- 禁用 WorkManager 自动初始化（androidx.startup），
             改为由 Application 实现 Configuration.Provider 接口按需初始化。
             首次调用 WorkManager.getInstance() 时自动用 Application 提供的 Configuration 初始化，
             避免在 ContentProvider 阶段（冷启动关键路径）初始化 WorkManager。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
