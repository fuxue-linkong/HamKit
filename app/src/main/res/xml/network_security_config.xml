<?xml version="1.0" encoding="utf-8"?>
<!--
  传输安全策略（2026-11 安全审计后收紧）：

  base-config 恢复平台默认：
    · 禁止明文（cleartextTrafficPermitted 默认 false）；
    · 只信任系统 CA，不再信任用户安装的证书（防企业 MDM/恶意 CA 解密全部流量）。

  AI 助手接入内网的特殊需求（明文 http、自签 HTTPS）不再由 manifest 层放行，
  全部收敛到业务层代码：
    · 明文 http：OkHttp 不强制 scheme，由 AiNetworkPolicy.validate 在请求前校验
      「用户显式开启开关 + host 为私有地址（10/8、172.16/12、192.168/16、
      localhost、.local、.lan）」，公网 http 直接拒绝；
    · 自签 HTTPS：由 AiHttp.trustAll 客户端处理（同样仅限私有地址，见 AiHttp）；
    · 其它业务（高德/AMSAT/SatNOGS/GitHub/aprs.fi）全部 https，不提供降级。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
