# ============================================================
# HamKit 官网配置示例
# 复制为 .env 后按需修改；.env 不要提交到仓库。
# 已存在的真实环境变量优先，.env 不会覆盖它们。
# ============================================================

# ---------- 基础 ----------
# 监听
PORT=8787
HOST=0.0.0.0
# 对外地址：必须是外网可访问的绝对地址，用于拼 OIDC 回调地址与判断 Cookie 安全性
BASE_URL=https://hamkit.click
# development | production（production 会忽略 DEV_LOGIN）
NODE_ENV=production
# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ---------- 会话 ----------
# 生产环境必须显式配置（48 位以上随机串）；不配则自动生成并落盘 data/.session-secret
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
# 可选：Cookie 名 / 域 / SameSite（HTTPS 下 COOKIE_SECURE 自动为 true）
# SESSION_COOKIE_NAME=hamkit_session
# COOKIE_DOMAIN=
# COOKIE_SAMESITE=Lax
# COOKIE_SECURE=true

# ---------- OIDC（至少填 ISSUER + CLIENT_ID） ----------
# 你的身份提供方 issuer，例如：
#   Keycloak    https://id.example.com/realms/hamkit
#   Authentik   https://id.example.com/application/o/hamkit/
#   Casdoor     https://id.example.com
#   Auth0       https://your-tenant.eu.auth0.com/
#   Google      https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
# 机密客户端填密钥；公共客户端（仅 PKCE）留空即自动使用 none
OIDC_CLIENT_SECRET=
# 令牌端点认证方式：client_secret_basic（默认）| client_secret_post | none
# OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_SCOPE=openid profile email
# 回调地址固定为 ${BASE_URL}/auth/callback，请到 IdP 侧登记

# IdP 不提供 Discovery 时手动指定端点（三个都要）
# OIDC_AUTHORIZATION_ENDPOINT=https://id.example.com/authorize
# OIDC_TOKEN_ENDPOINT=https://id.example.com/token
# OIDC_JWKS_URI=https://id.example.com/.well-known/jwks.json
# 也可以只覆盖 Discovery 地址
# OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# OIDC_USERINFO_ENDPOINT=
# OIDC_END_SESSION_ENDPOINT=

# 允许的 ID Token 签名算法（默认已放行 RS*/PS*/ES*/EdDSA，留空即用默认）
# OIDC_ALLOWED_ALGS=RS256,ES256
# JWKS / Discovery 缓存与轮换刷新冷却
# OIDC_CACHE_TTL_SEC=600
# OIDC_JWKS_COOLDOWN_SEC=30
# 时钟容差（秒）
# OIDC_CLOCK_TOLERANCE_SEC=60
# 是否用 userinfo 补齐资料（ID Token 已含所需信息时可关掉）
# OIDC_USE_USERINFO=true

# IdP 角色 → 本站角色映射
# 取值：admin（全部权限）| editor（内容与版本维护）| viewer（只读）
OIDC_ROLE_CLAIM=roles
# OIDC_ROLE_MAP=hamkit-admin:admin,hamkit-editor:editor,hamkit-viewer:viewer

# 额外授权参数（逗号分隔），例如强制重新选择账号：
# OIDC_EXTRA_AUTH_PARAMS=prompt=select_account

# ---------- 授权策略 ----------
# 首个登录用户自动成为管理员：默认关闭，避免公开 IdP 自注册时被“抢先接管”。
# 首次部署请用 BOOTSTRAP_ADMINS 或 OIDC_ROLE_MAP 指定管理员。
FIRST_USER_IS_ADMIN=false
# 直接授予管理员的邮箱 / 用户名（逗号分隔），优先级高于 IdP 角色映射
# BOOTSTRAP_ADMINS=you@example.com
# 邮箱域名白名单，非空时仅允许这些域名登录
# ALLOWED_EMAIL_DOMAINS=example.com
# 是否允许 viewer 角色登录后台
ALLOW_VIEWER_LOGIN=true
# 要求 admin/editor 的 OIDC 登录带 MFA 声明（amr/acr）；在 IdP 配置 MFA 后开启
OIDC_REQUIRE_MFA=false

# ---------- 安全 ----------
# 信任的反向代理层数；Nginx 单层代理填 1，用于获取真实客户端 IP
TRUST_PROXY=1
# 管理接口限流（每窗口每 IP 的请求数）
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=240
LOGIN_RATE_LIMIT_MAX=30
# HTTPS 下默认开启 HSTS
# ENABLE_HSTS=true

# ---------- 统计 ----------
STATS_ENABLED=true
STATS_RETENTION_DAYS=180
# 是否把客户端 IP 写入统计（隐私考虑默认关闭）
STATS_STORE_IP=false

# ---------- 数据 ----------
# 数据目录（版本 / 内容 / 公告 / 用户 / 审计 / 统计）
DATA_DIR=./data

# ---------- 开发 ----------
# 开发直登：无凭据即可登录后台，仅供本地调试；NODE_ENV=production 时会被忽略
# DEV_LOGIN=true
# 调试日志
# DEBUG=true
